# Wonderland Escrow — Apache config for SiteGround.
# Clean URLs, compression, caching, and security headers.

Options -MultiViews
RewriteEngine On

# Serve /net-sheet as /net-sheet.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

# Strip .html from URLs (301 so link equity moves with it)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Force HTTPS + non-www (adjust if you prefer www)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # CSS and JS are deliberately SHORT-lived. Nothing here is fingerprinted -- the filenames
  # never change, and site.css is reached through an @import inside wonderland.css, so a
  # ?v= query on the <link> would not refresh it either. With a long max-age a returning
  # visitor keeps stale CSS for the life of the cache and simply does not see a deploy.
  # Apache still sends ETag/Last-Modified, so these revalidate into cheap 304s.
  # If you ever want year-long immutable caching back, fingerprint the filenames first
  # (site.a1b2c3.css) and update both the <link> tags and the @import list.
  ExpiresByType text/css "access plus 5 minutes"
  ExpiresByType application/javascript "access plus 5 minutes"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Keep staging out of search results. Host-scoped, so production is unaffected.
  SetEnvIf Host ^staging\. IS_STAGING=1
  Header set X-Robots-Tag "noindex, nofollow" env=IS_STAGING
</IfModule>

ErrorDocument 404 /404.html
