# Wonderland Escrow — Apache config for SiteGround.
# Clean URLs, compression, caching, and security headers.

Options -MultiViews
RewriteEngine On

# Serve /net-sheet as /net-sheet.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

# Strip .html from URLs (301 so link equity moves with it)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Force HTTPS + non-www (adjust if you prefer www)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Safe to cache hard: every css/js reference carries a ?v= stamped with the deploy commit
  # (see .github/workflows/deploy.yml), including the @import list in wonderland.css and the
  # fee-schedule module import. Note SiteGround fronts static files with nginx, which ignores
  # these directives entirely -- the version query is what actually busts the cache.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Keep staging out of search results. Host-scoped, so production is unaffected.
  SetEnvIf Host ^staging\. IS_STAGING=1
  Header set X-Robots-Tag "noindex, nofollow" env=IS_STAGING
</IfModule>

ErrorDocument 404 /404.html
